{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vite: dev",
            "type": "shell",
            "command": "pnpm dev",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Local:.*http://localhost:1420"
                }
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "focus": false,
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
